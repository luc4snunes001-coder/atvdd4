
body {
  font-family: Arial, sans-serif;
  margin: 0;
  padding: 0;
  background-color: #f5f5f5;
  color: #222;
}

.header {
  background-color: #d32f2f;
  color: white;
  padding: 15px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header h1 {
  margin: 0;
  font-size: 22px;
}

#btnDark {
  background: white;
  color: #222;
  border: 1px solid #ccc;
  padding: 6px 12px;
  cursor: pointer;
  border-radius: 4px;
}

.container {
  max-width: 800px;
  margin: 20px auto;
  padding: 0 15px;
}

.lista-carros {
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
}

.card {
  background: white;
  border: 1px solid #dd
  padding: 15px;
  border-radius: 5px;
  width: 220px;
}

.card h3 {
  margin-top: 0;
  font-size: 18px;
}

.preco {
  font-size: 18px;
  font-weight: bold;
  color: #2e7d32;
}

.btn-comprar {
  background-color: #222;
  color: white;
  border: none;
  padding: 8px 10px;
  width: 100%;
  cursor: pointer;
  border-radius: 3px;
}

body.dark {
  background-color: #121212;
  color: #e0e0e0;
}

body.dark .header {
  background-color: #1f1f1f;
  border-bottom: 1px solid #333;
}

body.dark #btnDark {
  background: #333;
  color: white;
  border-color: #555;
}

body.dark .card {
  background: #1e1e1e;
  border-color: #333;
}

body.dark .preco {
  color: #81c784;
}

body.dark .btn-comprar {
  background-color: #d32f2f;
}
